@model IEnumerable<Prenda>
@{
    ViewData["Title"] = "Prendas";
}

<div class="page-actions">
    <div>
        <h1>Prendas</h1>
        <p class="subtitle">Inventario, tallas y precios</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Prenda</a>
</div>

<div class="card" style="padding: 1.25rem; margin-bottom: 1.5rem;">
    <form method="get" class="search-bar">
        <div class="form-group">
            <label>Buscar</label>
            <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Nombre o talla..." />
        </div>
        <div class="form-group">
            <label>Categoria</label>
            <select name="categoriaId" asp-items="ViewBag.Categorias" class="form-control">
                <option value="">Todas</option>
            </select>
        </div>
        <button type="submit" class="btn btn-secondary">Filtrar</button>
    </form>
</div>

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>Prenda</th>
                <th>Categoria</th>
                <th>Talla</th>
                <th>Color</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.Stock <= 10 ? "row-warning" : "")">
                    <td>
                        <div class="product-cell">
                            @{
                                var catNombre = item.Categoria?.Nombre?.ToLower() ?? "";
                                var iconChar = catNombre.Contains("pantalon") ? "&#128086;"
                                             : catNombre.Contains("vestido") ? "&#128087;"
                                             : catNombre.Contains("chaqueta") || catNombre.Contains("abrigo") ? "&#129509;"
                                             : "&#128085;";
                            }
                            <span class="icon icon-sm icon-category">@Html.Raw(iconChar)</span>
                            <div>
                                <span class="product-cell-name">@item.Nombre</span>
                                @if (!string.IsNullOrEmpty(item.Color))
                                {
                                    <span class="product-cell-sub"> · @item.Color</span>
                                }
                            </div>
                        </div>
                    </td>
                    <td>@item.Categoria?.Nombre</td>
                    <td>@(item.Talla ?? "—")</td>
                    <td>@(item.Color ?? "—")</td>
                    <td>$@item.Precio.ToString("N2")</td>
                    <td>
                        <span class="badge @(item.Stock <= 5 ? "badge-danger badge-pulse" : item.Stock <= 10 ? "badge-warning" : "badge-success")">
                            @item.Stock
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Ver</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">&#128085;</div>
            <p>No se encontraron prendas.</p>
        </div>
    }
</div>
