@model Prenda
@{
    ViewData["Title"] = "Nueva Prenda";
}

<div class="page-header">
    <h1>Registrar Prenda</h1>
</div>

<div class="form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="form-group">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="form-group">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="CategoriaId"></label>
            <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-control">
                <option value="">-- Seleccione --</option>
            </select>
            <span asp-validation-for="CategoriaId"></span>
        </div>
        <div class="form-group">
            <label asp-for="Talla"></label>
            <input asp-for="Talla" class="form-control" placeholder="S, M, L, 32, etc." />
            <span asp-validation-for="Talla"></span>
        </div>
        <div class="form-group">
            <label asp-for="Color"></label>
            <input asp-for="Color" class="form-control" placeholder="Rojo, Azul, Negro, etc." />
            <span asp-validation-for="Color"></span>
        </div>
        <div class="form-group">
            <label asp-for="Precio"></label>
            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="Precio"></span>
        </div>
        <div class="form-group">
            <label asp-for="Stock"></label>
            <input asp-for="Stock" class="form-control" type="number" min="0" />
            <span asp-validation-for="Stock"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
