@model Venta
@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="page-actions">
    <div>
        <h1>Venta @Model.NumeroFactura</h1>
        <p class="subtitle">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div>
        <a asp-action="Factura" asp-route-id="@Model.Id" class="btn btn-primary">Ver Factura</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

<div class="card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
    <div class="detail-grid">
        <div class="detail-item"><label>Cliente</label><span>@(Model.Cliente?.NombreCompleto ?? "Sin cliente")</span></div>
        <div class="detail-item"><label>Email</label><span>@(Model.Cliente?.Email ?? "—")</span></div>
        <div class="detail-item"><label>Empleado</label><span>@Model.Empleado?.NombreCompleto</span></div>
        <div class="detail-item"><label>Total</label><span style="color: var(--primary); font-size: 1.25rem; font-weight: 700;">$@Model.Total.ToString("N2")</span></div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2>Detalle de la venta</h2></div>
    <table class="table">
        <thead>
            <tr>
                <th>Prenda</th>
                <th>Categoría</th>
                <th>Talla</th>
                <th>Cantidad</th>
                <th>Precio unit.</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model.DetalleVentas)
            {
                <tr>
                    <td>@detalle.Prenda?.Nombre</td>
                    <td>@detalle.Prenda?.Categoria?.Nombre</td>
                    <td>@(detalle.Prenda?.Talla ?? "—")</td>
                    <td>@detalle.Cantidad</td>
                    <td>$@detalle.PrecioUnitario.ToString("N2")</td>
                    <td class="text-right">$@detalle.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
