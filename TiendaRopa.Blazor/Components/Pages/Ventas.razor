@page "/ventas"
@rendermode InteractiveServer
@inject IVentaService VentaService

<PageTitle>Ventas - Tienda Ropa</PageTitle>

<div style="max-width: 1100px; margin: 0 auto; padding: 2rem;">
    <h1 style="font-family: 'Oswald', sans-serif; text-transform: uppercase; margin-bottom: 1.5rem;">Ventas</h1>

    @if (ventas == null)
    {
        <p>Cargando...</p>
    }
    else if (!ventas.Any())
    {
        <div style="text-align: center; padding: 3rem; background: #f9f9f9; border-radius: 12px;">
            <p>No hay ventas registradas.</p>
        </div>
    }
    else
    {
        <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06);">
            <thead style="background: #111; color: white;">
                <tr>
                    <th style="padding: .75rem 1rem; text-align: left;">Factura</th>
                    <th style="padding: .75rem 1rem; text-align: left;">Cliente</th>
                    <th style="padding: .75rem 1rem; text-align: left;">Empleado</th>
                    <th style="padding: .75rem 1rem; text-align: left;">Fecha</th>
                    <th style="padding: .75rem 1rem; text-align: right;">Total</th>
                    <th style="padding: .75rem 1rem; text-align: center;">Items</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in ventas)
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: .75rem 1rem; font-weight: 600;">@v.NumeroFactura</td>
                        <td style="padding: .75rem 1rem;">@(v.ClienteNombre ?? "Sin cliente")</td>
                        <td style="padding: .75rem 1rem;">@v.EmpleadoNombre</td>
                        <td style="padding: .75rem 1rem;">@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="padding: .75rem 1rem; text-align: right; font-weight: 600; color: #070;">$@v.Total.ToString("N2")</td>
                        <td style="padding: .75rem 1rem; text-align: center;">
                            <span style="background: #f0f0f0; padding: .25rem .75rem; border-radius: 20px; font-size: .8rem;">@v.Detalles.Count prendas</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<VentaDto>? ventas;

    protected override async Task OnInitializedAsync()
    {
        ventas = await VentaService.GetAllAsync();
    }
}
