@page "/"
@rendermode InteractiveServer
@inject IVentaService VentaService
@inject IPrendaService PrendaService
@inject IClienteService ClienteService
@inject IEmpleadoService EmpleadoService

<PageTitle>Dashboard - Tienda Ropa</PageTitle>

<div style="max-width: 1100px; margin: 0 auto; padding: 2rem;">
    <h1 style="font-family: 'Oswald', sans-serif; text-transform: uppercase; margin-bottom: 1.5rem;">Dashboard</h1>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); text-align: center;">
            <div style="font-size: 2rem; font-weight: 900; font-family: 'Oswald';">@(prendas?.Count ?? 0)</div>
            <div style="color: #888; text-transform: uppercase; font-size: .8rem; letter-spacing: .05em;">Prendas</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); text-align: center;">
            <div style="font-size: 2rem; font-weight: 900; font-family: 'Oswald';">@(clientes?.Count ?? 0)</div>
            <div style="color: #888; text-transform: uppercase; font-size: .8rem; letter-spacing: .05em;">Clientes</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); text-align: center;">
            <div style="font-size: 2rem; font-weight: 900; font-family: 'Oswald';">@(ventas?.Count ?? 0)</div>
            <div style="color: #888; text-transform: uppercase; font-size: .8rem; letter-spacing: .05em;">Ventas</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); text-align: center;">
            <div style="font-size: 2rem; font-weight: 900; font-family: 'Oswald';">@(prendas?.Sum(p => p.Stock) ?? 0)</div>
            <div style="color: #888; text-transform: uppercase; font-size: .8rem; letter-spacing: .05em;">En Inventario</div>
        </div>
    </div>

    <h2 style="font-family: 'Oswald'; margin-bottom: 1rem;">Ventas recientes</h2>
    @if (ventas != null && ventas.Any())
    {
        <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.06); margin-bottom: 2rem;">
            <thead style="background: #111; color: white;">
                <tr>
                    <th style="padding: .75rem 1rem; text-align: left;">Factura</th>
                    <th style="padding: .75rem 1rem; text-align: left;">Cliente</th>
                    <th style="padding: .75rem 1rem; text-align: left;">Fecha</th>
                    <th style="padding: .75rem 1rem; text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in ventas.Take(5))
                {
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: .75rem 1rem; font-weight: 600;">@v.NumeroFactura</td>
                        <td style="padding: .75rem 1rem;">@(v.ClienteNombre ?? "Sin cliente")</td>
                        <td style="padding: .75rem 1rem;">@v.Fecha.ToString("dd/MM/yyyy")</td>
                        <td style="padding: .75rem 1rem; text-align: right;">$@v.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color: #888;">No hay ventas registradas.</p>
    }
</div>

@code {
    private List<PrendaDto>? prendas;
    private List<ClienteDto>? clientes;
    private List<VentaDto>? ventas;

    protected override async Task OnInitializedAsync()
    {
        prendas = await PrendaService.GetAllAsync();
        clientes = await ClienteService.GetAllAsync();
        ventas = await VentaService.GetAllAsync();
    }
}
